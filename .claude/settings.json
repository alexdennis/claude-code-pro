{
  "worktree": {
    "symlinkDirectories": ["node_modules", "web/node_modules"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/format-and-typecheck.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
